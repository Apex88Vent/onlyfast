# Copy to .env.qa.local here; never commit local credentials/configuration.
# The server reads the anonymous key from the verified LOCAL workspace only.
ONLYFAST_QA_TESTER_UUID=
ONLYFAST_QA_ANDROID_KEY=
ONLYFAST_QA_IOS_KEY=
# Leave empty for Android loopback. Set only after secured HTTPS access approval.
ONLYFAST_QA_HTTPS_ORIGIN=
# Do not change until an explicit sandbox transaction scope is approved.
ONLYFAST_QA_STORE_ACTIONS_APPROVED=false
